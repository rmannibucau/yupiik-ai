<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
  <modelVersion>4.1.0</modelVersion>
  <parent />
  <artifactId>github-bot</artifactId>
  <name>YCA :: GitHub Bot</name>
  <properties>
    <jib.version>3.5.2</jib.version>
    <github-bot.dispatcher.base-image>eclipse-temurin:25-jre</github-bot.dispatcher.base-image>
    <github-bot.dispatcher.image>yca-github-dispatcher:local</github-bot.dispatcher.image>
    <!-- No agent base default: supply a vetted JDK 25 and development toolchain image. -->
    <github-bot.agent.image>yca-github-agent:local</github-bot.agent.image>
    <github-bot.egress.base-image>eclipse-temurin:25-jre</github-bot.egress.base-image>
    <github-bot.egress.image>yca-egress:local</github-bot.egress.image>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.yupiik.ia.agent</groupId>
      <artifactId>core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-build-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-processor</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.yupiik.fusion</groupId>
      <artifactId>fusion-kubernetes-client</artifactId>
      <version>${fusion.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <compilerArg>-Afusion.moduleFqn=io.yupiik.ia.agent.github.GithubBotModule</compilerArg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>fatjar</id>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>fatjar</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.yupiik.fusion.framework.api.main.CliLauncher</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <!-- Image creation is explicit only; never bind Jib goals to the build lifecycle. -->
  <profiles>
    <profile>
      <id>image-dispatcher</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <version>${jib.version}</version>
            <configuration>
              <from>
                <image>${github-bot.dispatcher.base-image}</image>
              </from>
              <to>
                <image>${github-bot.dispatcher.image}</image>
              </to>
              <container>
                <mainClass>io.yupiik.fusion.framework.api.main.CliLauncher</mainClass>
                <user>10001:10001</user>
                <environment>
                  <HOME>/tmp</HOME>
                </environment>
              </container>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>image-agent</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <version>${jib.version}</version>
            <configuration>
              <from>
                <image>${github-bot.agent.base-image}</image>
              </from>
              <to>
                <image>${github-bot.agent.image}</image>
              </to>
              <container>
                <mainClass>io.yupiik.fusion.framework.api.main.CliLauncher</mainClass>
                <user>10001:10001</user>
                <environment>
                  <HOME>/attempt/storage</HOME>
                </environment>
              </container>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>image-egress</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <version>${jib.version}</version>
            <configuration>
              <from>
                <image>${github-bot.egress.base-image}</image>
              </from>
              <to>
                <image>${github-bot.egress.image}</image>
              </to>
              <container>
                <mainClass>io.yupiik.ia.agent.github.execution.EgressGateway</mainClass>
                <user>65532:65532</user>
                <jvmFlags>
                  <jvmFlag>-Xmx128m</jvmFlag>
                </jvmFlags>
              </container>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
