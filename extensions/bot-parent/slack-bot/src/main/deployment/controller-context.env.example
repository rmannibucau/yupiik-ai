# Separate Docker --env-file overlay, applied AFTER controller.env.
# Not read automatically by the base launcher. See context.adoc launcher changes.
# Start disabled; enable only after assembled tests and separate operator approval.
SLACK_CONTEXT_ENABLED=false
SLACK_CONTEXT_RESOLVEMENTIONS=true
SLACK_CONTEXT_SEARCHENABLED=false
SLACK_CONTEXT_SOURCECHANNELS=
SLACK_CONTEXT_MAXMEMBERS=8
SLACK_CONTEXT_MAXREQUESTS=4
SLACK_CONTEXT_MAXRESULTS=5
SLACK_CONTEXT_MAXRESPONSEBYTES=32768
SLACK_CONTEXT_MAXCONCURRENT=1
SLACK_CONTEXT_ACTIONRETENTIONSECONDS=600
SLACK_EXECUTOR_BACKEND=DOCKER
SLACK_EXECUTOR_ATTEMPTROOT=/run/yca-slack-context-attempts
SLACK_EXECUTOR_SHOWTOOLOUTPUT=hidden
# Neutral shared docker.disableContainerLogs property; default elsewhere is false.
SLACK_EXECUTOR_DOCKER_DISABLECONTAINERLOGS=true
SLACK_EXECUTOR_DOCKER_SERVICES_DEPENDENCYEGRESS_ENABLED=false
# No admission/channel/requester changes, credentials, tracing or cache settings here.
