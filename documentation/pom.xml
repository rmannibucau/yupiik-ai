<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.yupiik.fusion.a2a</groupId>
        <artifactId>fusion-a2a-server-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>fusion-a2a-server-documentation</artifactId>
    <packaging>jar</packaging>
    <name>Fusion A2A Server :: Documentation</name>
    <description>Minisite of the project: end user guide and design notes.</description>

    <properties>
        <yupiik-tools.version>1.2.15</yupiik-tools.version>

        <!-- nothing to deploy, the artifact only carries the asciidoc sources -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency><!-- brings the ConfigurationDocumentationGenerator pre-action used below -->
            <groupId>io.yupiik.fusion</groupId>
            <artifactId>fusion-documentation</artifactId>
            <version>${fusion.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency><!-- so the module is built after it and its generated configuration metadata is available -->
            <groupId>io.yupiik.fusion.a2a</groupId>
            <artifactId>fusion-a2a-server-impl</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency><!-- idem for the openrpc document the demo skills are documented from -->
            <groupId>io.yupiik.fusion.a2a</groupId>
            <artifactId>fusion-a2a-server-demo</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource><!-- potential reuse + warning free build -->
                <directory>src/main/minisite</directory>
            </resource>
        </resources>

        <plugins>
            <!-- mvn -pl documentation yupiik-tools:serve-minisite -e   to write the doc with a live preview -->
            <plugin>
                <groupId>io.yupiik.maven</groupId>
                <artifactId>yupiik-tools-maven-plugin</artifactId>
                <version>${yupiik-tools.version}</version>
                <configuration>
                    <preferYupiikAsciidoc>true</preferYupiikAsciidoc>
                    <siteBase>//yupiik.github.io/fusion-a2a-server</siteBase>
                    <title>Fusion A2A Server documentation</title>
                    <description>Turn a Yupiik Fusion application into an Agent2Agent agent - skills are plain
                        JSON-RPC methods.
                    </description>
                    <indexText>Fusion A2A Server</indexText>
                    <indexSubTitle>An Agent2Agent server built on the Yupiik Fusion JSON-RPC stack.</indexSubTitle>
                    <logoText>Fusion A2A Server</logoText>
                    <logoSideText>Documentation</logoSideText>
                    <copyright>© 2026 &lt;strong&gt;&lt;a href="https://www.yupiik.com"&gt;Yupiik&lt;/a&gt;&lt;/strong&gt;.
                        All Rights Reserved
                    </copyright>
                    <attributes>
                        <partialsdir>${project.basedir}/src/main/minisite/content/_partials</partialsdir>
                        <projectVersion>${project.version}</projectVersion>
                        <fusionVersion>${fusion.version}</fusionVersion>
                        <a2aVersion>1.0</a2aVersion>
                        <a2aSpecVersion>1.0.1</a2aSpecVersion>
                    </attributes>
                    <templateExtensionPoints>
                        <socialLinks>
                            &lt;li class="list-inline-item"&gt;&lt;a title="Github" target="_blank"
                            href="https://www.github.com/yupiik/fusion-a2a-server"&gt;&lt;i class="fab fa-github
                            fa-fw"&gt;&lt;/i&gt;&lt;/a&gt;&lt;/li&gt;
                        </socialLinks>
                    </templateExtensionPoints>
                    <preActions>
                        <preAction>
                            <!--
                              generates content/_partials/generated/documentation.a2a.adoc from the @RootConfiguration
                              metadata of A2AConfiguration, so the configuration reference can never drift.
                              the source is pinned instead of scanned to only document our own keys - the classpath
                              also carries the Fusion ones.
                            -->
                            <type>io.yupiik.fusion.documentation.ConfigurationDocumentationGenerator</type>
                            <configuration>
                                <module>a2a</module>
                                <formatter>table</formatter>
                                <includeEnvironmentNames>true</includeEnvironmentNames>
                                <urls>
                                    ${project.basedir}/../a2a-server/target/classes/META-INF/fusion/configuration/documentation.json
                                </urls>
                            </configuration>
                        </preAction>
                        <preAction>
                            <!--
                              generates the reference of the demo skills from the openrpc document the processor wrote
                              for the demo module, so the skill descriptions and their schemas come from the code and not
                              from a page somebody has to remember to update. It documents the demo methods only: the
                              A2A operations live in the document of the a2a-server module.
                            -->
                            <type>io.yupiik.fusion.documentation.OpenRPC2Adoc</type>
                            <configuration>
                                <input>
                                    ${project.basedir}/../demo/target/classes/META-INF/fusion/jsonrpc/openrpc.json
                                </input>
                                <output>
                                    ${project.basedir}/src/main/minisite/content/_partials/generated/demo.skills.adoc
                                </output>
                                <!-- no tableAttributes: the generator already sizes its own four columns -->
                            </configuration>
                        </preAction>
                    </preActions>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>io.yupiik.maven</groupId>
                        <artifactId>asciidoc-java</artifactId>
                        <version>${yupiik-tools.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile><!-- by default refresh the generated content on any build but do not render the site -->
            <id>generate-content-but-not-site</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.yupiik.maven</groupId>
                        <artifactId>yupiik-tools-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>buildDoc</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>minisite</goal>
                                </goals>
                                <configuration>
                                    <skipRendering>true</skipRendering>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile><!-- mvn clean package -Prender-site   then open documentation/target/fusion-a2a-server-documentation/index.html -->
            <id>render-site</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.yupiik.maven</groupId>
                        <artifactId>yupiik-tools-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>render</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>minisite</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile><!-- mvn clean package -Pgh-pages -->
            <id>gh-pages</id>
            <properties>
                <minisite.serverId>github.com</minisite.serverId>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.yupiik.maven</groupId>
                        <artifactId>yupiik-tools-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>gh-pages</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>minisite</goal>
                                </goals>
                                <configuration>
                                    <git>
                                        <ignore>false</ignore>
                                        <noJekyll>true</noJekyll>
                                        <serverId>${minisite.serverId}</serverId>
                                        <branch>refs/heads/gh-pages</branch>
                                        <url>https://github.com/yupiik/fusion-a2a-server.git</url>
                                    </git>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
