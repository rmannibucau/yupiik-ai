    <plugins>
      <plugin>
        <groupId>io.yupiik.maven</groupId>
        <artifactId>yupiik-tools-maven-plugin</artifactId>
        <configuration>
          <preferYupiikAsciidoc>true</preferYupiikAsciidoc>
          <title>${project.name}</title>
          <description>${project.description}</description>
          <indexText>${project.name}</indexText>
          <indexSubTitle>${project.description}</indexSubTitle>
          <logoText>yca</logoText>
          <logoSideText>Documentation</logoSideText>
          <copyright>(c) 2026 Yupiik SAS</copyright>
          <attributes>
            <partialsdir>${project.basedir}/src/main/minisite/content/_partials</partialsdir>
            <project_name>${project.name}</project_name>
            <project_version>${project.version}</project_version>
            <project_description>${project.description}</project_description>
          </attributes>
          <generateIndex>true</generateIndex>
          <siteBase>/fusion-coding-agent</siteBase>
          <includeProvidedScope>true</includeProvidedScope>
          <customScripts><![CDATA[
<style>
/* mermaid diagrams: the renderer emits a bare pre.mermaid (roles are
   dropped by visitMermaid), so center diagrams and let them take the full
   available width via a global rule on the pre and its svg. */
pre.mermaid {
  background: transparent;
  text-align: center;
  display: block;
  width: 100%;
  margin: 0;
  padding: .75rem 0;
  overflow-x: auto;
}
pre.mermaid svg {
  display: block;
  max-width: 100%;
  height: auto;
  margin: 0 auto;
}
/* definition-list terms (generated option/command references) */
dt.hdlist1 { font-weight: 600; }
</style>
]]></customScripts>
          <preActions>
            <preAction>
              <type>io.yupiik.fusion.documentation.CliDocumentationGenerator</type>
              <configuration>
                <indexHeader><![CDATA[= YCA CLI

TIP: all options can also be passed in environment variables
if uppercased, dot/hyphens replaced by underscores and leading hyphens/dots removed.
]]></indexHeader>
              </configuration>
            </preAction>
            <preAction>
              <type>io.yupiik.fusion.documentation.DocumentationGenerator</type>
              <configuration>
                <includeEnvironmentNames>true</includeEnvironmentNames>
                <formatter>definitionlist</formatter>
                <namePrefix>!github.,!poll.,!worker.,!filterKind,!filterRepository,!filterState,!task,!repository,!number,!kind,!request,!dryRun,!retentionDays</namePrefix>
              </configuration>
            </preAction>
            <preAction>
              <type>io.yupiik.fusion.documentation.DocumentationGenerator</type>
              <configuration>
                <urls>${project.basedir}/../extensions/bot-parent/github-bot/target/classes/META-INF/fusion/configuration/documentation.json</urls>
                <module>github-bot</module>
                <includeEnvironmentNames>true</includeEnvironmentNames>
                <formatter>definitionlist</formatter>
                <namePrefix>github.</namePrefix>
              </configuration>
            </preAction>
            <!-- Contextual references: one metadata input and unique output per scope. -->
